#  models.py — DATA STORAGE (Book Structure)
#  This is where we define what a Book looks like
# ============================================================

# Each book is a dictionary with these fields:
#   - title       : name of the book
#   - author      : who wrote it
#   - is_borrowed : True if someone borrowed it, False if available
#   - borrowed_by : student name (empty string if not borrowed)

# ===== SAMPLE DATA =====
books = [
    {
        "id":          1,
        "title":       "Python Basics",
        "author":      "Ana Cruz",
        "is_borrowed": False,
        "borrowed_by": ""
    },
    {
        "id":          2,
        "title":       "Django for Students",
        "author":      "Mark Reyes",
        "is_borrowed": False,
        "borrowed_by": ""
    },
    {
        "id":          3,
        "title":       "Data Structures",
        "author":      "Lea Santos",
        "is_borrowed": False,
        "borrowed_by": ""
    },
]


# ===== HELPER: Find a book by ID =====
def get_book_by_id(book_id):
    for book in books:
        if book["id"] == book_id:
            return book
    return None

