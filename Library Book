# ============================================================
#  views.py — PROGRAM LOGIC (Functions that manipulate books)
#  Each function does one specific job
# ============================================================

from models import books, get_book_by_id


# ===== FUNCTION 1: Show all books =====
def show_all_books():
    print("\n" + "=" * 50)
    print("         ALL BOOKS IN THE LIBRARY")
    print("=" * 50)

    if not books:
        print("  No books found.")
    else:
        for book in books:
            status = "BORROWED by " + book["borrowed_by"] if book["is_borrowed"] else "AVAILABLE"
            print(f"  [{book['id']}] {book['title']}")
            print(f"       Author : {book['author']}")
            print(f"       Status : {status}")
            print()

    print("=" * 50)


# ===== FUNCTION 2: Borrow a book =====
def borrow_book():
    show_available_books()

    try:
        book_id = int(input("\n  Enter Book ID to borrow: "))
    except ValueError:
        print("  Invalid input. Please enter a number.")
        return

    book = get_book_by_id(book_id)

    if book is None:
        print("  Book not found.")
        return

    if book["is_borrowed"]:
        print(f"  Sorry! '{book['title']}' is already borrowed by {book['borrowed_by']}.")
        return

    student_name = input("  Enter your name: ").strip()

    if not student_name:
        print("  Name cannot be empty.")
        return

    # UPDATE the book data
    book["is_borrowed"] = True
    book["borrowed_by"] = student_name

    print(f"\n  SUCCESS! '{book['title']}' has been borrowed by {student_name}.")


# ===== FUNCTION 3: Return a book =====
def return_book():
    show_borrowed_books()

    try:
        book_id = int(input("\n  Enter Book ID to return: "))
    except ValueError:
        print("  Invalid input. Please enter a number.")
        return

    book = get_book_by_id(book_id)

    if book is None:
        print("  Book not found.")
        return

    if not book["is_borrowed"]:
        print(f"  '{book['title']}' is not currently borrowed.")
        return

    borrower = book["borrowed_by"]

    # UPDATE the book data
    book["is_borrowed"] = False
    book["borrowed_by"] = ""

    print(f"\n  SUCCESS! '{book['title']}' has been returned by {borrower}. Thank you!")


# ===== FUNCTION 4: Show only available books =====
def show_available_books():
    available = [b for b in books if not b["is_borrowed"]]

    print("\n" + "=" * 50)
    print("         AVAILABLE BOOKS")
    print("=" * 50)

    if not available:
        print("  No books are currently available.")
    else:
        for book in available:
            print(f"  [{book['id']}] {book['title']} — by {book['author']}")

    print("=" * 50)


# ===== FUNCTION 5: Show only borrowed books =====
def show_borrowed_books():
    borrowed = [b for b in books if b["is_borrowed"]]

    print("\n" + "=" * 50)
    print("         BORROWED BOOKS")
    print("=" * 50)

    if not borrowed:
        print("  No books are currently borrowed.")
    else:
        for book in borrowed:
            print(f"  [{book['id']}] {book['title']} — by {book['author']}")
            print(f"       Borrowed by: {book['borrowed_by']}")
            print()

    print("=" * 50)
